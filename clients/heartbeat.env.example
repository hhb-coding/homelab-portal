# HomeLab Portal Linux heartbeat client configuration
# HomeLab Portal Linux heartbeat 客户端配置示例

HOMELAB_PORTAL_URL=http://your-portal-host:8088

# Use the same shared token configured on the Portal server.
# 使用 Portal 服务端配置的同一个认证 Token。
HOMELAB_HEARTBEAT_TOKEN=change-me

# Unique stable ID for this device.
# 每台设备必须拥有唯一且稳定的 ID。
HOMELAB_DEVICE_ID=example-linux-server

# Friendly name displayed in HomeLab Portal.
# HomeLab Portal 中显示的友好设备名称。
HOMELAB_DISPLAY_NAME="Example Linux Server"
