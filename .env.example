# HomeLab Portal configuration example
# Copy this file to .env and adjust values for your environment.

APP_NAME=HomeLab Portal

# Local-only example. Set a suitable listen address for trusted remote clients.
# 默认仅本机访问；可信远程客户端需要自行配置监听地址。
HOST=127.0.0.1
PORT=8088
DEBUG=false

DATABASE_PATH=data/homelab.db


# Device heartbeat authentication
# Device heartbeat 认证
# Generate a private random token; blank disables the heartbeat endpoint.
# 自行生成私有随机 Token；留空时心跳接口禁用。
HEARTBEAT_TOKEN=

# Registry device_id of the Linux host running Portal; blank = unavailable.
# 运行 Portal 的 Linux 主机在注册表中的 device_id；留空则频率不可用。
LOCAL_DEVICE_ID=

# ------------------------------------------------------------
# Beszel integration / Beszel 集成
# ------------------------------------------------------------

# Internal URL of the Beszel Hub.
# HomeLab Portal 与 Beszel 在同一主机时建议使用 localhost。
BESZEL_URL=http://127.0.0.1:8090

# Authentication options.
# Do NOT commit real credentials.
# 不要把真实账号、密码或 Token 提交到 GitHub。
BESZEL_EMAIL=
BESZEL_PASSWORD=
BESZEL_TOKEN=

# HTTP timeout in seconds / HTTP 超时时间（秒）
BESZEL_TIMEOUT=10

# Independent 180-day raw metrics archive / 独立 180 天原始指标归档。
# UUID must identify the actual HDD; do not substitute the SSD UUID.
# UUID 必须对应真实 HDD，不可使用 SSD UUID。
METRICS_ARCHIVE_PATH=/srv/data/homelab-portal-archive/metrics.sqlite3
METRICS_ARCHIVE_MOUNT=/srv/data
# Required: fill privately after checking the HDD; blank fails closed.
# 必填：核实 HDD 后在私有配置填写；留空拒绝运行。
METRICS_ARCHIVE_UUID=
# Optional Step 7.03 features, default off; explicit v2 migration required.
# 可选频率功能默认关闭；历史库必须另行显式迁移。
FREQUENCY_ARCHIVE_ENABLED=false
FREQUENCY_HISTORY_ENABLED=false
